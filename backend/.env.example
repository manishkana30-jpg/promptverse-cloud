# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==========================================
# SUPABASE (DATABASE, AUTH & STORAGE)
# ==========================================
# Your Supabase Project URL (e.g., https://xyz.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# The Service Role Key allows the backend to bypass Row Level Security.
# WARNING: NEVER put this key in the frontend code!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# PAYMENTS & BILLING (RAZORPAY)
# ==========================================
# Find these in Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Required to verify webhook signatures so users can't fake successful payments
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==========================================
# THE "DIRECTOR" LLM (STORYBOARD GENERATION)
# ==========================================
# If using OpenRouter (e.g., Qwen / Claude / Llama)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# If using OpenAI (e.g., GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# AI GENERATION APIs (VIDEO, AUDIO, LIP-SYNC)
# ==========================================
# Fal.ai (Used for fast Video Generation & sometimes Lip-Sync)
FAL_KEY=fal_your_secret_key_here

# Replicate (Alternative for Video generation or Wav2Lip syncing)
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ElevenLabs (Used for high-quality Voiceovers)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# SyncLabs (Specialized Lip-Syncing API, if you choose to use it over Replicate)
SYNCLABS_API_KEY=your_synclabs_api_key_here